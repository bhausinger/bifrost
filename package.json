{
  "name": "campaign-manager",
  "version": "2.0.0",
  "description": "Spotify playlist placement agency — internal management tool",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "restart:force": "lsof -ti:5173,9999 | xargs kill -9 2>/dev/null; sleep 1; (cd apps/scraper && ./venv/bin/python run.py &); turbo run dev",
    "prepare": "husky",
    "test:scraper": "cd apps/scraper && PYTHONPATH=src python -m pytest tests/ -v",
    "test:db": "bash supabase/tests/run-db-tests.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.17.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "bash scripts/check-file-size.sh"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
